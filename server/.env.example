# 复制为 server/.env 并填写真实值（.env 已被 gitignore）
# MongoDB 连接串（本地默认 mongodb://127.0.0.1:27017/pinche；
# 生产建议 MongoDB Atlas M0 免费层）
MONGODB_URI=mongodb://127.0.0.1:27017/pinche

# 服务端口
PORT=3000

# 允许跨域来源（逗号分隔）。开发时前端 Taro dev server 默认 http://localhost:10086；
# 生产若由本服务直接托管 web/ 静态文件则为同源，可留空。
# 例：CORS_ORIGINS=http://localhost:10086
CORS_ORIGINS=

# 是否托管前端静态文件（web/ 目录）。生产同域部署时设为 true。
# SERVE_WEB=true
